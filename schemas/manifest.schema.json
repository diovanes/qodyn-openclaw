{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "release", "policy", "agents"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "owner", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "owner": { "type": "string", "minLength": 2 },
        "description": { "type": "string", "minLength": 10 }
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "minimumOpenClawVersion"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([+-][0-9A-Za-z.-]+)?$" },
        "minimumOpenClawVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([+-][0-9A-Za-z.-]+)?$" }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredFiles", "optionalFiles", "unmanagedFiles", "maxBytes"],
      "properties": {
        "requiredFiles": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "optionalFiles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "unmanagedFiles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "maxBytes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
      }
    },
    "agents": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "description", "files", "skills"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
          "source": { "type": "string", "pattern": "^agents/[a-z][a-z0-9-]{1,62}$" },
          "description": { "type": "string", "minLength": 10 },
          "files": { "type": "array", "items": { "type": "string" }, "minItems": 2, "uniqueItems": true },
          "skills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }, "uniqueItems": true }
        }
      }
    }
  }
}
