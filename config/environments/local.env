OPENCLAW_PROMPT_ENVIRONMENT=local
OPENCLAW_WORKSPACE_ROOT=${HOME}/.openclaw/workspaces
OPENCLAW_BACKUP_ROOT=${HOME}/.openclaw/prompt-backups
OPENCLAW_BIN=openclaw
OPENCLAW_RUN_CONFIG_VALIDATE=true
OPENCLAW_RUN_SECURITY_AUDIT=false
OPENCLAW_RUN_DEEP_SECURITY_AUDIT=false
OPENCLAW_RUN_GATEWAY_STATUS=false
OPENCLAW_RUN_AGENTS_LIST=false
