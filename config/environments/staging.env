OPENCLAW_PROMPT_ENVIRONMENT=staging
OPENCLAW_WORKSPACE_ROOT=/srv/openclaw-staging/workspaces
OPENCLAW_BACKUP_ROOT=/srv/openclaw-staging/prompt-backups
OPENCLAW_BIN=openclaw
OPENCLAW_RUN_CONFIG_VALIDATE=true
OPENCLAW_RUN_SECURITY_AUDIT=true
OPENCLAW_RUN_DEEP_SECURITY_AUDIT=false
OPENCLAW_RUN_GATEWAY_STATUS=true
OPENCLAW_RUN_AGENTS_LIST=true
