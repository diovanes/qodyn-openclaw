{
  "schemaVersion": "workspace-v1",
  "project": {
    "name": "openclaw-workspace",
    "description": "Espelho versionado da estrutura do workspace OpenClaw."
  },
  "workspace": {
    "agents": [
      "admin_master",
      "aura_test01_default",
      "auraflow_main",
      "auraflow_orchestrator_isis",
      "main",
      "mpp_isis"
    ],
    "sharedDirectories": [
      ".openclaw",
      "clients",
      "memory",
      "state",
      "Workflow"
    ]
  },
  "globalConfiguration": [
    "config/openclaw.json.example",
    "config/global/plugins/installs.json.example",
    "config/global/credentials",
    "config/global/devices",
    "config/global/logs"
  ],
  "runtimeExcluded": [
    "workspace-state.json",
    "auth-profiles.json",
    "auth-state.json",
    "models.json",
    "codex-home",
    "sessions",
    "logs",
    "credentials",
    "devices",
    "client memory"
  ]
}
