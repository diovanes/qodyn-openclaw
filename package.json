{
  "name": "openclaw-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Versioned OpenClaw workspace structure",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "lint:md": "node scripts/lint-markdown.mjs",
    "test:shell": "bash scripts/check-shell.sh",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "check": "npm run lint:md && npm run validate && npm run test:shell && npm run scan:secrets",
    "build": "node scripts/build.mjs",
    "package": "bash scripts/package-release.sh"
  }
}
